{
  "name": "new_blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run copy-images && next dev",
    "build": "npm run copy-images && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "copy-images": "node scripts/copy-post-images.js",
    "optimize-images": "node scripts/optimize-images.js",
    "optimize-images:dry": "node scripts/optimize-images.js --dry-run",
    "prebuild": "npm run copy-images",
    "predev": "npm run copy-images",
    "clean": "rm -rf .next && rm -rf public/images/posts",
    "fresh-build": "npm run clean && npm run build"
  },
  "dependencies": {
    "@fontsource/irish-grover": "^5.2.7",
    "@shikijs/rehype": "^4.1.0",
    "firebase": "^12.13.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.2.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-mailchimp-subscribe": "^2.1.3",
    "react-minimal-pie-chart": "^9.1.2",
    "react-share": "^5.3.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-mailchimp-subscribe": "^2.1.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "typescript": "^6.0.3"
  }
}
